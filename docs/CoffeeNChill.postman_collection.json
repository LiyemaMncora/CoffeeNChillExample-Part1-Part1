{
  "info": {
    "_postman_id": "b03299d7-6ed2-4be7-84cd-8aeffe07e953",
    "name": "CoffeeNChill - Part 1 (Azure Functions)",
    "description": "HTTP endpoint tests for the CoffeeNChill Canteen Management System - Part 1 (Menu Items via Azure Table Storage, Staff Documents via Azure Blob Storage). Run against a local func host or the standalone Docker container.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Menu Items",
      "item": [
        {
          "name": "Create Menu Item",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response contains the created item\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.Name).to.eql(\"Espresso\");",
                  "    pm.expect(jsonData.PartitionKey).to.eql(\"Hot Drinks\");",
                  "    pm.expect(jsonData.RowKey).to.eql(\"COF-001\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/menu",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "menu"
              ]
            },
            "description": "Creates a new menu item in the MenuItems table.",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"PartitionKey\": \"Hot Drinks\",\n    \"RowKey\": \"COF-001\",\n    \"Name\": \"Espresso\",\n    \"Description\": \"Single shot of rich, bold espresso\",\n    \"Price\": 25.0,\n    \"IsAvailable\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Get All Menu Items",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response is an array\", function () {",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/menu",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "menu"
              ]
            },
            "description": "Returns every menu item across all categories."
          },
          "response": []
        },
        {
          "name": "Get Menu Items By Category",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"All returned items belong to the requested category\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    jsonData.forEach(function (item) {",
                  "        pm.expect(item.PartitionKey).to.eql(\"Hot Drinks\");",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/menu/category/Hot Drinks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "menu",
                "category",
                "Hot Drinks"
              ]
            },
            "description": "Filters menu items by PartitionKey (category)."
          },
          "response": []
        },
        {
          "name": "Update Menu Item",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Price and availability were updated\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.Price).to.eql(28.50);",
                  "    pm.expect(jsonData.IsAvailable).to.eql(false);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/menu/Hot Drinks/COF-001",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "menu",
                "Hot Drinks",
                "COF-001"
              ]
            },
            "description": "Updates the price and availability of an existing menu item.",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"PartitionKey\": \"Hot Drinks\",\n    \"RowKey\": \"COF-001\",\n    \"Name\": \"Espresso\",\n    \"Description\": \"Single shot of rich, bold espresso\",\n    \"Price\": 28.5,\n    \"IsAvailable\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Delete Menu Item",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/menu/Hot Drinks/COF-001",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "menu",
                "Hot Drinks",
                "COF-001"
              ]
            },
            "description": "Removes a menu item. Run 'Create Menu Item' again before re-running this."
          },
          "response": []
        },
        {
          "name": "Delete Menu Item (Not Found)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 404 Not Found\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/menu/Hot Drinks/DOES-NOT-EXIST",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "menu",
                "Hot Drinks",
                "DOES-NOT-EXIST"
              ]
            },
            "description": "Confirms deleting a non-existent item returns 404."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Staff Documents",
      "item": [
        {
          "name": "Upload Staff Document",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/documents/upload",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "documents",
                "upload"
              ]
            },
            "description": "Uploads a file via multipart/form-data. Attach a file under the 'file' key before sending (e.g. a barista recipe PDF).",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "List Staff Documents",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response is an array\", function () {",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/documents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "documents"
              ]
            },
            "description": "Lists every file stored in the staff-docs Blob container with name, size and last modified date."
          },
          "response": []
        },
        {
          "name": "Download Staff Document",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/documents/download/{{fileName}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "documents",
                "download",
                "{{fileName}}"
              ]
            },
            "description": "Streams back the requested file. Set the 'fileName' collection variable to match a file you uploaded."
          },
          "response": []
        },
        {
          "name": "Download Staff Document (Not Found)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 404 Not Found\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/documents/download/does-not-exist.pdf",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "documents",
                "download",
                "does-not-exist.pdf"
              ]
            },
            "description": "Confirms downloading a file that doesn't exist returns 404."
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:7071/api",
      "type": "string"
    },
    {
      "key": "fileName",
      "value": "sample-recipe.pdf",
      "type": "string"
    }
  ]
}